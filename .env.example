# FlashCache-KV Configuration Template
# Copy this file to .env and configure local environment settings

# Hardware Device: 'cuda', 'cpu', or 'auto'
FLASHCACHE_DEVICE=auto

# Quantization Precision: 4 or 2
FLASHCACHE_DEFAULT_BITS=4

# Default Chunk Size in tokens
FLASHCACHE_DEFAULT_CHUNK_SIZE=16

# Sink Tokens (preserved initial tokens)
FLASHCACHE_SINK_TOKENS=4

# Recent Tokens (preserved tail tokens)
FLASHCACHE_RECENT_TOKENS=32

# Offline mode for huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
